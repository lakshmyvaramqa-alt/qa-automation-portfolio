<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Automation Exercise - Parallel Cross-Browser Suite" parallel="tests" thread-count="2" verbose="1">

    <listeners>
        <listener class-name="com.varalakshmy.listeners.AllureListener"/>
    </listeners>

    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.varalakshmy.tests.ContactUsAndStaticTests"/>
        </classes>
    </test>

    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.varalakshmy.tests.ContactUsAndStaticTests"/>
        </classes>
    </test>

</suite>
