# PostgreSQL Database Connection Settings (Docker / Local / Remote)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pagila

# Runner Mode: 'docker' (uses pg library to connect to DB_HOST) or 'embedded' (runs in-memory Postgres 16 via PGlite)
# If DB_HOST is unreachable, runner automatically falls back to embedded mode.
DB_MODE=auto
