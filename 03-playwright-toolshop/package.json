{
  "name": "playwright-toolshop",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright TypeScript automation framework for Practice Software Testing Toolshop",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test --grep @api",
    "test:visual": "playwright test --grep @visual",
    "test:hybrid": "playwright test --grep @hybrid",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=\"Mobile Chrome (Pixel 7)\"",
    "report": "playwright show-report",
    "lint": "eslint ."
  },
  "keywords": [
    "playwright",
    "typescript",
    "testing",
    "automation",
    "api-testing",
    "visual-regression"
  ],
  "author": "Varalakshmy M",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.1",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.1",
    "typescript": "^5.7.3"
  }
}
